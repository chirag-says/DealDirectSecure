# Copy to .env.local and fill in. Every NEXT_PUBLIC_ value is inlined into the
# browser bundle at build time and is readable by anyone who opens devtools, so
# only non-secret values belong here.

# The API base INCLUDING the /api prefix. Every backend route is mounted under
# /api except /health and /ping.
NEXT_PUBLIC_API_URL=http://localhost:9000/api

# Alternative to the above, WITHOUT the /api prefix. src/utils/api.js appends it.
# Set one or the other, not both.
# NEXT_PUBLIC_API_BASE=http://localhost:9000

# OPTIONAL. Google Sign-In.
#
# Unset, the Google button and its divider do not render at all and email +
# password works exactly as before. That is what lets the backend deploy before
# the OAuth credentials exist, and it is why an unconfigured build is a usable
# build rather than a broken one.
#
# Use the WEB client ID from Google Cloud Console, and add this site's origin to
# that client's "Authorised JavaScript origins" — Google Identity Services
# refuses to render the button on an origin it does not recognise, with the
# reason only in the browser console.
#
# Must match GOOGLE_CLIENT_ID_WEB in the backend's .env, which is what the
# backend accepts as the token audience.
# NEXT_PUBLIC_GOOGLE_CLIENT_ID=000000000000-xxxxxxxx.apps.googleusercontent.com

# OPTIONAL. Sentry DSN for browser error reporting. A DSN is a public
# write-only key, so it belongs with the other NEXT_PUBLIC_ values.
# NEXT_PUBLIC_SENTRY_DSN=
