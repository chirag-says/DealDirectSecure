# DealDirect web — Next.js 16 (App Router, Turbopack), own repo, own hosting.

# ---------------------------------------------------------------------------
# Dependencies
# ---------------------------------------------------------------------------
/node_modules
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
!.yarn/sdks

# ---------------------------------------------------------------------------
# Build output
#
# `.next` holds both dev and production artifacts. Running `next build` while
# a dev server is using the same directory leaves a mixed state: freshly
# compiled server output alongside stale client chunks, which surfaces as a
# React hydration mismatch rather than as any kind of build error. If that
# happens, delete `.next` and restart.
# ---------------------------------------------------------------------------
/.next/
/out/
/build
.turbo/
next-env.d.ts
*.tsbuildinfo

# ---------------------------------------------------------------------------
# Secrets
#
# NEXT_PUBLIC_* values are compiled into the browser bundle and are public by
# definition. Anything here that is NOT prefixed NEXT_PUBLIC_ is server-only
# and genuinely secret.
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example

.sentryclirc
.env.sentry-build-plugin
*.pem
*.key
*.p12
*.pfx
credentials.json

# ---------------------------------------------------------------------------
# Deployment and hosting
# ---------------------------------------------------------------------------
.vercel

# ---------------------------------------------------------------------------
# Logs, coverage, test artifacts
# ---------------------------------------------------------------------------
build.log
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

/coverage
.nyc_output/
/playwright-report/
/test-results/

# ---------------------------------------------------------------------------
# SCRATCH
#
# Explicit markers only. The previous file carried `test-*.js`, which would
# have matched a real component or route file named with that prefix and
# removed it from git without any visible sign.
# ---------------------------------------------------------------------------
scratch/
*.scratch.js
*.scratch.jsx
*.local.js
tmp/
temp/
*.tmp

# Database dumps, in case one is ever taken from this directory.
dump/
dumps/
backups/
*.bson
*.archive

# ---------------------------------------------------------------------------
# Editors and OS
# ---------------------------------------------------------------------------
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
*.swo
*.sw?
*~
.gemini/
.claude/
.DS_Store
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
desktop.ini
