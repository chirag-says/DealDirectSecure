# ==============================================================
# DealDirect — Public Site (Next.js 16 App Router)
#
# This repo is standalone: nothing above this folder is ignored on
# its behalf, so everything needed must be listed here.
# ==============================================================

# ---------- Dependencies ----------
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
!.yarn/sdks

# ---------- Next.js build output ----------
/.next/
/out/
/build
.turbo/
next-env.d.ts

# ---------- Secrets ----------
# .env.local          → dev config + NEXT_PUBLIC_MAPPLES_API_KEY
# .env.production     → contains a real SENTRY_AUTH_TOKEN (build-time
#                       credential that can upload source maps and read
#                       the Sentry project). MUST NOT be committed.
#
# Anything NEXT_PUBLIC_* is inlined into the browser bundle and is
# public by definition — restrict those keys at the provider by
# domain, never rely on them being secret.
.env
.env.local
.env.development
.env.development.local
.env.test
.env.test.local
.env.production
.env.production.local
.env*.local

# Sentry
.sentryclirc
.env.sentry-build-plugin

*.pem
*.key
*.p12
*.pfx

# ---------- Logs ----------
build.log
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ---------- Ad-hoc diagnostics ----------
test-*.js
__*.js
*.local.js
tmp/
temp/
*.tmp

# ---------- Testing / coverage ----------
/coverage
.nyc_output/
/playwright-report/
/test-results/

# ---------- Deployment ----------
.vercel

# ---------- TypeScript (if ever added) ----------
*.tsbuildinfo

# ---------- Editors & tooling ----------
.vscode/
!.vscode/extensions.json
.idea/
*.swp
*.swo
*.sw?
*~
.gemini/
.claude/

# ---------- OS ----------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ==============================================================
# DELIBERATELY NOT IGNORED
#
#   package-lock.json — required for reproducible builds.
#
#   src/app/sitemap.js, src/app/robots.js — source files that Next
#   compiles into /sitemap.xml and /robots.txt. Do not add
#   "sitemap.xml" or "robots.txt" patterns here; they would not
#   match these but the confusion is easy to create.
#
#   public/ — contains press PDFs and sample agreement PDFs that the
#   site serves. The backend ignores *.pdf; this app must not.
# ==============================================================
