{
  "name": "backend",
  "version": "1.0.0",
  "description": "DealDirect Backend API Server",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "test": "node --test tests/*.test.js",
    "test:integration": "node --env-file=tests/integration/test.env --test tests/integration/*.test.js",
    "test:all": "npm test && npm run test:integration",
    "start": "node --import ./instrument.js server.js",
    "dev": "nodemon --exec \"node --import ./instrument.js server.js\"",
    "build": "echo 'No build step required for backend'",
    "normalize-categories": "node scripts/normalizeCategoryName.js"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@json2csv/plainjs": "^7.0.6",
    "@sentry/node": "^10.38.0",
    "bcryptjs": "^3.0.2",
    "cloudinary": "^2.8.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "exceljs": "^4.4.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.2.1",
    "express-validator": "^7.3.1",
    "helmet": "^8.1.0",
    "hpp": "^0.2.3",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.19.2",
    "multer": "^2.0.2",
    "multer-storage-cloudinary": "^2.2.1",
    "nodemailer": "^7.0.10",
