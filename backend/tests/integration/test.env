# Environment for the integration harness. Contains no secrets and is committed
# deliberately: the isolation guard refuses to run unless NODE_ENV is exactly
# "test", and this is how `npm run test:integration` sets it on every platform
# without depending on shell syntax (NODE_ENV=x does not work in cmd.exe) or on
# a cross-env package.
#
# Every other value the suite needs is synthetic and set in
# tests/integration/setup/externals.js.
NODE_ENV=test
