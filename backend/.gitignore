# DealDirect API — Express 5 on Node, deployed from this folder's own repo.
#
# Two rules worth stating, because the previous version of this file broke
# both and the failure is silent:
#
#   1. No word-prefix globs against .js. `test*.js`, `check*.js`, `verify*.js`
#      and `debug*.js` were all here. They read as "ignore my scratch files"
#      and they also match `testimonialController.js`, `checkoutController.js`
#      and `verifyOtp.js` — plausible names in this codebase. A file caught
#      that way is invisible to `git status` and absent from the next clone,
#      with no warning. Scratch work carries an explicit marker instead.
#
#   2. To keep a file inside an otherwise-ignored directory, exclude the
#      CONTENTS, not the directory. `uploads/` then `!uploads/.gitkeep` does
#      not work; `uploads/*` then `!uploads/.gitkeep` does.

# ---------------------------------------------------------------------------
# Dependencies
# ---------------------------------------------------------------------------
node_modules/
.npm/
.pnpm-store/
jspm_packages/

# ---------------------------------------------------------------------------
# Secrets
#
# The API holds the real ones: MONGO_URI, JWT_SECRET, CLOUDINARY_URL,
# SMTP_PASS, GEMINI_API_KEY. .env.example is the template and is committed.
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example

*.pem
*.key
*.crt
*.cer
*.p12
*.pfx
*.gpg
*.asc
private_key*
public_key*
credentials.json
service-account*.json

# ---------------------------------------------------------------------------
# Database dumps and backups
#
# mongodump writes .bson holding every document in plain form — user emails,
# phone numbers, agreement contents. It must never reach a remote, private or
# otherwise.
# ---------------------------------------------------------------------------
dump/
dumps/
backup/
backups/
*.bson
*.archive
*.dump
*.bak
*.backup
*.sql
*.sqlite
*.sqlite3
mongodump-*/

# ---------------------------------------------------------------------------
# Runtime data
#
# Uploads go to Cloudinary; this directory is the transient local staging area
# multer writes to. The contents are ignored, the directory itself is kept, so
# a fresh deploy has somewhere to write.
# ---------------------------------------------------------------------------
uploads/*
!uploads/.gitkeep

logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---------------------------------------------------------------------------
# Generated exports
#
# The lead and user export endpoints write XLSX, CSV and PDF. Scoped to the
# folders they are written into rather than ignoring the extensions globally,
# so a committed fixture or template is still possible.
# ---------------------------------------------------------------------------
exports/
reports/
/*.xlsx
/*.csv
/*.pdf

# ---------------------------------------------------------------------------
# SCRATCH
#
# Explicit markers, so no controller or model can ever collide with them.
# ---------------------------------------------------------------------------
scratch/
*.scratch.js
*.scratch.mjs
*.local.js
*.local.mjs
tmp/
temp/
*.tmp
*.temp
.debug/

# One-off operational scripts, listed by exact path. Adding a new script under
# scripts/ should be a decision, not something a wildcard here makes silently.
seed.js
seedAdmin.js
scripts/seedBlogs.js
scripts/fixAdminRole.js
scripts/debugRbac.js
scripts/testAdminLogin.js
generate_report.js

# NOTE: scripts/seedRbac.js was also ignored here and has been left ignored.
# It is worth revisiting — it is the only definition of the 45 permissions and
# four roles that production actually runs, it was deleted from the working
# tree, and it now survives only as a dangling object in git history.

# ---------------------------------------------------------------------------
# Tests
#
# The suites under tests/ ARE the deliverable and are committed in full. No
# rule here should exclude them; this section exists to say so, because an
# earlier `*.test.js` rule with re-including negations came close to losing
# them whenever a suite moved into a new subdirectory.
# ---------------------------------------------------------------------------
coverage/
.nyc_output/

# ---------------------------------------------------------------------------
# Editors and OS
# ---------------------------------------------------------------------------
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
*.swo
*.sw?
*~
.gemini/
.claude/
.DS_Store
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
desktop.ini

# Working documents
HOSTINGER_SETUP.md
SECURITY_REFACTOR.md
