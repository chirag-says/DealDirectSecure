# ==============================================================
# DealDirect — Backend (Express 5 + Mongoose)
#
# This repo is standalone: nothing above this folder is ignored on
# its behalf, so everything needed must be listed here.
# ==============================================================

# ---------- Dependencies ----------
node_modules/
.npm/
.pnpm-store/
jspm_packages/

# ---------- Secrets ----------
# .env holds MONGO_URI, JWT_SECRET, CLOUDINARY_URL, SMTP_PASS,
# GEMINI_API_KEY, EQUENCE_*, WAHA_*, HUBBLE_*, SENTRY_DSN.
# Never commit any variant. .env.example is the documented template.
.env
.env.*
!.env.example

# Keys and certificates
*.pem
*.key
*.crt
*.cer
*.p12
*.pfx
private_key*
public_key*
*.gpg
*.asc

# ---------- Seed / one-off scripts holding credentials ----------
seed.js
seedAdmin.js
seedRbac.js
scripts/seedRbac.js
scripts/seedBlogs.js
scripts/fixAdminRole.js
scripts/debugRbac.js
scripts/testAdminLogin.js

# ---------- Runtime output ----------
# Legacy local upload path. Cloudinary is the real store; anything
# landing here is transient. .gitkeep preserves the directory.
uploads/*
!uploads/.gitkeep

logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---------- Generated reports / exports ----------
# Lead and user exports (PDF/CSV/XLSX) contain personal data.
*.xlsx
*.csv
*.pdf
generate_report.js

# ---------- Ad-hoc diagnostics ----------
# Throwaway verification scripts (SMTP checks, Sentry smoke tests,
# DB probes). Useful locally, not application code.
#
# Patterns are deliberately broad: an earlier version only had
# "test-*.js", which missed "testdb.js" and let it reach the remote.
# Anything starting with "test" or "check", and anything ending in
# "-test"/"-check", is treated as scratch work.
test*.js
check*.js
verify*.js
debug*.js
*-test.js
*-check.js
*.test.js
*.spec.js
__*.js
*.local.js
scratch*.js

# ...except the committed regression suite. The patterns above keep throwaway
# diagnostic scripts out of the repo; tests/ is the real suite and is tracked
# (see the matching rule in the root .gitignore). Non-test files inside it stay
# ignored by the root rule.
!tests/*.test.js


tmp/
temp/
*.tmp
*.temp
.debug/

# ---------- Testing / coverage ----------
coverage/
.nyc_output/

# ---------- Editors & tooling ----------
.vscode/
!.vscode/extensions.json
.idea/
*.swp
*.swo
*.sw?
*~
.gemini/
.claude/

# ---------- OS ----------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ---------- Internal docs, not for a shared repo ----------
HOSTINGER_SETUP.md
SECURITY_REFACTOR.md

# ==============================================================
# DELIBERATELY NOT IGNORED
#
#   package-lock.json — was previously ignored; that has been
#   reversed. A backend deployed to a server needs reproducible
#   installs, and without the lockfile a deploy can silently pull a
#   different transitive dependency than the one that was tested.
#   Run `git add -f package-lock.json` once to start tracking it.
#
#   instrument.js — required. Loads env and initialises Sentry, and
#   must remain the first import in server.js.
# ==============================================================
