# Copy to .env and fill in. Both values are PUBLIC (inlined into the bundle).
#
# Production defaults, frozen 2026-07-31:
#   EXPO_PUBLIC_API_URL=https://backend.dealdirect.in/api
#   EXPO_PUBLIC_SOCKET_URL=https://backend.dealdirect.in
#
# These are the values baked into the `preview` and `production` EAS profiles
# (see eas.json). The variables stay configurable so a developer can point at a
# local or staging backend without editing committed files.
#
# The backend mounts every REST route under /api, and Socket.IO attaches at the
# server ROOT. That is why these are two values rather than one derived from the
# other by trimming a suffix.

# Local development against a backend on the host machine.
EXPO_PUBLIC_API_URL=http://localhost:9000/api
EXPO_PUBLIC_SOCKET_URL=http://localhost:9000

# On a physical device, localhost is the DEVICE. Use the host machine's LAN IP:
# EXPO_PUBLIC_API_URL=http://192.168.1.10:9000/api
# EXPO_PUBLIC_SOCKET_URL=http://192.168.1.10:9000

# The backend sets COOKIE_DOMAIN=.dealdirect.in, so the session cookie issued by
# backend.dealdirect.in is scoped to the whole apex domain.

# OPTIONAL. Public website origin, used only to build shareable links, which
# point at its /properties/:id route. Left unset, sharing a listing sends its
# title, price and location with no link — deliberately, because a guessed
# domain produces a link that looks right and 404s. Set it to whatever origin
# actually serves client-next.
# EXPO_PUBLIC_WEB_URL=https://dealdirect.in

# OPTIONAL. Sentry DSN for crash reporting. A DSN is a public write-only key
# (it identifies the project, it cannot read from it), so it belongs here with
# the other EXPO_PUBLIC_ values. Left unset, the SDK never initialises and
# nothing leaves the device. Reports carry the user's id and role only.
# EXPO_PUBLIC_SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0

# OPTIONAL. Google Sign-In. Unset, the Google buttons are not rendered and email
# + password works exactly as before — which is what lets the backend and the
# app ship on separate days.
#
# The WEB client ID is required on EVERY platform, Android included: the Android
# SDK uses it as `webClientId` to mint a token audienced to our backend. Without
# it `idToken` comes back null and it looks like a backend fault.
#
# Android additionally needs the signing-certificate SHA-1 registered against
# the ANDROID OAuth client in Google Cloud Console, one per variant — debug,
# upload, and Play App Signing. Miss the Play App Signing one and sign-in works
# everywhere except the build users install.
#
# These must match GOOGLE_CLIENT_ID_WEB / _IOS in the backend's .env, which is
# what the backend accepts as the token audience.
# EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=000000000000-xxxxxxxx.apps.googleusercontent.com
# EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=000000000000-yyyyyyyy.apps.googleusercontent.com
