# ==============================================================
# DealDirect — Mobile (Expo 54 + expo-router)
#
# This repo is standalone: nothing above this folder is ignored on
# its behalf, so everything needed must be listed here.
# ==============================================================

# ---------- Dependencies ----------
node_modules/
.npm/
.pnpm-store/

# ---------- Expo / build output ----------
.expo/
.expo-shared/
dist/
web-build/
expo-env.d.ts

# Native projects are generated by `expo prebuild` and are not committed.
/ios
/android

# ---------- Secrets ----------
# Both EXPO_PUBLIC_* values are inlined into the shipped bundle and
# are public by definition — anyone who unzips the app can read them.
# Ignored anyway so a real key is never committed by reflex.
# Keys that must stay private are restricted at the provider by
# bundle identifier, never hidden in the bundle.
.env
.env.local
.env.*.local
.env.production
!.env.example

# Signing material — committing any of these lets someone publish
# an app as you. Never commit.
*.jks
*.keystore
*.p8
*.p12
*.pem
*.key
*.mobileprovision
*.cer
*.certSigningRequest
google-services.json
GoogleService-Info.plist

# EAS local credentials
credentials.json
.easignore.local

# ---------- Logs ----------
*.log
npm-debug.*
yarn-debug.*
yarn-error.*
pnpm-debug.*

# ---------- Ad-hoc diagnostics ----------
test-*.ts
test-*.js
__*.ts
__*.js
tmp/
temp/
*.tmp
*.orig.*

# ---------- Testing / coverage ----------
coverage/
.nyc_output/

# ---------- TypeScript ----------
*.tsbuildinfo

# ---------- Editors & tooling ----------
.vscode/
!.vscode/extensions.json
.idea/
*.swp
*.swo
*.sw?
*~
.gemini/
.claude/

# ---------- OS ----------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ==============================================================
# DELIBERATELY NOT IGNORED
#
#   app.config.js — contains the FROZEN bundle identifiers
#   (in.dealdirect.mobile) and the EAS projectId. The projectId
#   identifies the project; it is not a credential.
#
#   eas.json — build profiles, no secrets.
#
#   package-lock.json — required for reproducible builds.
# ==============================================================
