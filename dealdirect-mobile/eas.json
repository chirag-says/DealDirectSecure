{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "env": {
        "EXPO_PUBLIC_API_URL": "http://localhost:9000/api",
        "EXPO_PUBLIC_SOCKET_URL": "http://localhost:9000"
      }
    },
    "preview": {
      "distribution": "internal",
      "android": { "buildType": "apk" },
      "channel": "preview",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://backend.dealdirect.in/api",
        "EXPO_PUBLIC_SOCKET_URL": "https://backend.dealdirect.in"
      }
    },
    "production": {
      "autoIncrement": true,
      "channel": "production",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://backend.dealdirect.in/api",
        "EXPO_PUBLIC_SOCKET_URL": "https://backend.dealdirect.in"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
