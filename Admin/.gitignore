# ==============================================================
# DealDirect — Admin Panel (Vite 6 + React 19)
#
# This repo is standalone: nothing above this folder is ignored on
# its behalf, so everything needed must be listed here.
# ==============================================================

# ---------- Dependencies ----------
node_modules/
.npm/
.pnpm-store/

# ---------- Build output ----------
dist/
dist-ssr/
build/
.vite/

# ---------- Secrets ----------
# Only VITE_API_BASE_URL lives here today, which is public by nature
# (anything VITE_-prefixed is inlined into the browser bundle).
# Still ignored, because the moment someone adds a real key to a
# .env file it must not be committed.
#
# NOTE: .env.production was previously TRACKED in git. Ignoring it
# here does NOT untrack it — run this once:
#     git rm --cached .env.production
.env
.env.*
!.env.example

*.pem
*.key
*.p12
*.pfx

# ---------- Logs ----------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ---------- Ad-hoc diagnostics ----------
test-*.js
__*.js
*.local.js
tmp/
temp/
*.tmp

# ---------- Testing / coverage ----------
coverage/
.nyc_output/

# ---------- Editors & tooling ----------
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp
*.swo
*.sw?
*~
.gemini/
.claude/

# ---------- OS ----------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ==============================================================
# DELIBERATELY NOT IGNORED
#
#   package-lock.json — was previously ignored; reversed so the
#   built bundle is reproducible. Run once to start tracking:
#       git add -f package-lock.json
#
#   public/_redirects and public/.htaccess — required for SPA
#   routing on the host. Without them a deep link 404s.
# ==============================================================
