# DealDirect admin dashboard — Vite + React, own repo, own hosting.

# ---------------------------------------------------------------------------
# Dependencies
# ---------------------------------------------------------------------------
node_modules/
.npm/
.pnpm-store/

# ---------------------------------------------------------------------------
# Build output
# ---------------------------------------------------------------------------
dist/
dist-ssr/
build/
.vite/
*.tsbuildinfo

# ---------------------------------------------------------------------------
# Secrets
#
# Every VITE_* value is inlined into the browser bundle at build time, so
# nothing here is truly secret — but these files still pin an environment and
# do not belong in a shared repo.
#
# One exception is deliberate: Admin/.env.production is tracked in the ROOT
# repository. It contains only VITE_API_BASE_URL, which is public, and the
# build reads it. Leaving it there is fine; just do not add anything else to
# that file expecting it to stay private.
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example

*.pem
*.key
*.p12
*.pfx
credentials.json

# ---------------------------------------------------------------------------
# Logs, coverage
# ---------------------------------------------------------------------------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

coverage/
.nyc_output/

# ---------------------------------------------------------------------------
# SCRATCH
#
# The previous file carried `test-*.js`. This dashboard is where an admin
# screen would most plausibly be named something like `test-connection.js`,
# so the pattern is replaced with markers that cannot collide with real code.
# ---------------------------------------------------------------------------
scratch/
*.scratch.js
*.scratch.jsx
*.local.js
tmp/
temp/
*.tmp

# Exports produced by the admin screens (lead exports, audit-log downloads).
exports/
/*.xlsx
/*.csv
/*.pdf

# Database dumps, in case one is ever taken from this directory.
dump/
dumps/
backups/
*.bson
*.archive

# ---------------------------------------------------------------------------
# Editors and OS
# ---------------------------------------------------------------------------
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp
*.swo
*.sw?
*~
.gemini/
.claude/
.DS_Store
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
desktop.ini
