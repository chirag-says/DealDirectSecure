# DealDirect — repository root
#
# This tree holds four independently hosted applications, each with its own
# git repository AND its own .gitignore. Files here are therefore tracked
# twice: once by the app repo that deploys them, once by this one. Keep this
# file to cross-cutting concerns and let each app's file own its build system.
#
# Two rules this file is built around, both learned the hard way:
#
#   1. Never glob a word prefix against a source extension. `test*.js` reads
#      as "scratch files" and matches `testimonialController.js`; `check*.js`
#      matches `checkoutController.js`. The file is then invisible to git and
#      absent from the next clone, with no error anywhere. Scratch work is
#      marked by an explicit suffix instead — see SCRATCH below.
#
#   2. A negation cannot rescue a file whose parent directory is excluded.
#      `uploads/` followed by `!uploads/.gitkeep` does NOT keep the file; the
#      directory is gone before the negation is read. Exclude the CONTENTS
#      (`uploads/*`) when something inside has to survive.

# ---------------------------------------------------------------------------
# Dependencies and build output
# ---------------------------------------------------------------------------
node_modules/
**/node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/releases
!.yarn/versions

dist/
**/dist/
build/
**/build/
out/
**/out/
dist-ssr/
**/dist-ssr/
.next/
**/.next/
.vite/
**/.vite/
.turbo/
**/.turbo/
web-build/
.eslintcache
*.tsbuildinfo

# ---------------------------------------------------------------------------
# Secrets
#
# .env.example files are templates and are meant to be committed; every other
# .env variant is not. The per-app negations exist because the broad `.env.*`
# rule above them would otherwise swallow the templates too.
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example
!*/.env.example

backend/.env
backend/.env.*
!backend/.env.example
client-next/.env
client-next/.env.*
!client-next/.env.example
Admin/.env
Admin/.env.*
!Admin/.env.example
dealdirect-mobile/.env
dealdirect-mobile/.env.*
!dealdirect-mobile/.env.example

# Keys, certificates and credential files
*.pem
*.key
*.crt
*.cer
*.p12
*.pfx
*.jks
*.keystore
*.p8
*.gpg
*.asc
*.secret
*.secrets
secrets/
.secrets/
credentials.json
service-account*.json
*-credentials.json
*-serviceaccount.json
google-services.json
GoogleService-Info.plist
.npmrc
.yarnrc
.docker/config.json

# ---------------------------------------------------------------------------
# Database dumps and backups
#
# A mongodump run from the repository root drops a directory of .bson here.
# Those carry every user record in the database in plain form, so they must
# never reach a remote — including a private one.
# ---------------------------------------------------------------------------
dump/
dumps/
backup/
backups/
*.bson
*.archive
*.dump
*.bak
*.backup
*.sql
*.sqlite
*.sqlite3
mongodump-*/
*-dump-*/

# ---------------------------------------------------------------------------
# SCRATCH
#
# Throwaway files use an explicit marker so no real module can collide with
# the pattern. Anything named `foo.scratch.js`, or anything under `scratch/`,
# is local-only by construction.
# ---------------------------------------------------------------------------
scratch/
**/scratch/
*.scratch.*
*.local.js
*.local.mjs
*.local.ts
tmp/
temp/
.tmp/
.temp/
*.tmp
*.temp
.cache/
**/.cache/

# One-off operational scripts that are deliberately not shipped. Listed by
# exact path rather than by prefix, so adding `seedCategories.js` later is a
# decision someone makes, not something this file makes for them.
backend/seed.js
backend/scripts/seedBlogs.js
backend/scripts/fixAdminRole.js
backend/scripts/debugRbac.js
backend/scripts/testAdminLogin.js
backend/generate_report.js
generate_task_sheet.py

# ---------------------------------------------------------------------------
# Logs, coverage, test artifacts
# ---------------------------------------------------------------------------
logs/
**/logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
lint-output.json
**/lint-output.json

coverage/
**/coverage/
.nyc_output/
test-results/
playwright-report/

# ---------------------------------------------------------------------------
# Runtime data
#
# `uploads/*` and not `uploads/`, so .gitkeep survives and a fresh clone still
# has the directory multer writes into.
# ---------------------------------------------------------------------------
backend/uploads/*
!backend/uploads/.gitkeep

